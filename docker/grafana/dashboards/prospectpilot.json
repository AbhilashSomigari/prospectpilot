      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (increase(pp_leads_processed_total[$__range]))",
          "legendFormat": "{{outcome}}"
