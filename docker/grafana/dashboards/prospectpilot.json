          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ppdb"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "\nSELECT 'r' || round AS round,\n       (metrics_before->>'p50_latency_ms')::float AS \"active (before)\",\n       (metrics_after->>'p50_latency_ms')::float  AS \"best candidate\"\nFROM improvement_rounds WHERE status = 'completed' ORDER BY improvement_rounds.round\n"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Improvement changelog",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ppdb"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ppdb"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT round, decision, provider, models->>'large' AS writer_model,\n                  (metrics_before->>'pass_rate')::float AS pass_before,\n                  (metrics_after->>'pass_rate')::float AS pass_after,\n                  (metrics_before->>'judge_mean')::float AS judge_before,\n                  (metrics_after->>'judge_mean')::float AS judge_after,\n                  finished_at\n           FROM improvement_rounds ORDER BY round DESC"
        }
      ]
    },
    {
