{
  "uid": "prospectpilot",
  "title": "ProspectPilot",
  "tags": [
    "prospectpilot"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Self-improvement loop (per round, from the changelog table)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "barchart",
      "title": "Quality: grounded-and-passing rate",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ppdb"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "xField": "round",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ppdb"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "\nSELECT 'r' || round AS round,\n       (metrics_before->>'pass_rate')::float AS \"active (before)\",\n       (metrics_after->>'pass_rate')::float  AS \"best candidate\"\nFROM improvement_rounds WHERE status = 'completed' ORDER BY improvement_rounds.round\n"
        }
      ]
    },
    {
      "id": 3,
      "type": "barchart",
      "title": "Cost per lead (USD)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ppdb"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "xField": "round",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ppdb"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "\nSELECT 'r' || round AS round,\n       (metrics_before->>'cost_per_task_usd')::float AS \"active (before)\",\n       (metrics_after->>'cost_per_task_usd')::float  AS \"best candidate\"\nFROM improvement_rounds WHERE status = 'completed' ORDER BY improvement_rounds.round\n"
        }
      ]
    },
    {
      "id": 4,
      "type": "barchart",
      "title": "Latency per lead p50 (ms)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
