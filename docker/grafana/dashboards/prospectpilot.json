            "uid": "ppdb"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT created_at, status, (stats->>'prospects')::int AS leads,\n                  (stats->>'final_pass')::int AS passed, (stats->>'emails_sent')::int AS sent,\n                  (stats->>'cost_usd')::float AS cost_usd, trace_id\n           FROM runs ORDER BY created_at DESC LIMIT 20"
