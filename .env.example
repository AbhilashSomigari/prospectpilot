# Copy to .env and fill in what you need. Nothing here is required for `make demo` (mock mode).

# --- database ---------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://prospectpilot:prospectpilot@localhost:5432/prospectpilot

# --- LLM provider: anthropic | openai | ollama | mock --------------------------
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# writer + optimizer use the large model; critic, extraction, reply simulator use the small one
ANTHROPIC_LARGE_MODEL=claude-sonnet-5-5
ANTHROPIC_SMALL_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_EFFORT=low

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_LARGE_MODEL=
OPENAI_SMALL_MODEL=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LARGE_MODEL=qwen2.5
OLLAMA_SMALL_MODEL=qwen2.5

# embeddings: hash (offline, deterministic) | ollama | openai
EMBEDDING_PROVIDER=hash
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- sources ----------------------------------------------------------------
GITHUB_TOKEN=
HTTP_CACHE_DIR=.cache/http

# --- sending (sandbox only) -------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_API_URL=http://localhost:8025
MAIL_FROM=ProspectPilot Demo <sdr@prospectpilot.test>
# Real sending additionally requires the --i-understand CLI flag. Leave false.
ALLOW_REAL_SEND=false

# --- observability ----------------------------------------------------------
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LANGFUSE_ENABLED=false
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
